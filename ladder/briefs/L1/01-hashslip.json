{
  "id": "hashslip",
  "kind": "cli",
  "message": "Build HashSlip, a Python stdlib CLI in hashslip.py. Read stdin as raw bytes and print one JSON object with bytes, lowercase SHA-256, and label (null unless --label TEXT). Empty and binary input are valid; preserve label text. Unknown flags exit 2 with stderr and no stdout. --help must not read stdin. Include a short usage example.",
  "profile": {
    "audience": "Shell users archiving exact bytes",
    "care": "Byte fidelity and clear usage errors",
    "tone": "concise, practical, predictable",
    "colours": "no terminal colour",
    "fonts": "system fonts only",
    "sections": "help, examples, concise diagnostics",
    "platform": "local Windows and Python 3 stdlib for CLI; modern desktop/mobile browser for web",
    "defaults": "Smallest solution described; no accounts, network, deployment or paid assets. Ask before scope or budget changes."
  },
  "files": [
    "hashslip.py"
  ],
  "oracle": [
    {
      "name": "empty-bytes",
      "type": "cli",
      "argv": [],
      "stdin_b64": "",
      "exit": 0,
      "stdout": {
        "json": {
          "bytes": 0,
          "sha256": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855",
          "label": null
        }
      },
      "stderr": {
        "exact": ""
      }
    },
    {
      "name": "binary-and-label",
      "type": "cli",
      "argv": [
        "--label",
        "  Café  "
      ],
      "stdin_b64": "AP8NCg==",
      "exit": 0,
      "stdout": {
        "json": {
          "bytes": 4,
          "sha256": "e9489f37fb3051e9efa1dc916004d7274e7b63975e3209708947267f2393a9be",
          "label": "  Café  "
        }
      },
      "stderr": {
        "exact": ""
      }
    },
    {
      "name": "unknown-flag",
      "type": "cli",
      "argv": [
        "--bogus"
      ],
      "stdin_b64": "",
      "exit": 2,
      "stdout": {
        "exact": ""
      },
      "stderr": {
        "not_empty": true
      }
    },
    {
      "name": "help-with-open-stdin",
      "type": "cli",
      "argv": [
        "--help"
      ],
      "stdin_b64": "",
      "exit": 0,
      "stdout": {
        "not_empty": true
      },
      "stderr": {
        "exact": ""
      },
      "stdin_open": true
    }
  ]
}
