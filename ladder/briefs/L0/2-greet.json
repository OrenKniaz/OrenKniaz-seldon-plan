{
  "id": "greet",
  "kind": "cli",
  "message": "Build greet.py, a single-file Python standard-library CLI. Accept exactly one nonempty NAME argument and print 'Hello, NAME!' with a newline; preserve NAME including spaces. Usage errors (including unknown flags and wrong argument count) exit 2, emit a nonempty diagnostic on stderr and no stdout. Successful runs exit 0 with no stderr. Use UTF-8 text.",
  "profile": {
    "audience": "Local users",
    "care": "Exact behavior and clear errors",
    "tone": "concise and practical",
    "colours": "calm neutral palette",
    "fonts": "system fonts only",
    "sections": "Only the requested features",
    "platform": "Windows, Python 3 standard library; desktop and mobile browser",
    "defaults": "Smallest solution described; no accounts, network assets, deployment or paid services."
  },
  "files": [
    "greet.py"
  ],
  "oracle": [
    {
      "name": "named-greeting",
      "type": "cli",
      "argv": [
        "Ada Lovelace"
      ],
      "stdin_b64": "",
      "exit": 0,
      "stdout": {
        "exact": "Hello, Ada Lovelace!\n",
        "normalize_newlines": true
      },
      "stderr": {
        "exact": ""
      }
    },
    {
      "name": "missing-name",
      "type": "cli",
      "argv": [],
      "stdin_b64": "",
      "exit": 2,
      "stdout": {
        "exact": "",
        "normalize_newlines": true
      },
      "stderr": {
        "not_empty": true
      }
    },
    {
      "name": "extra-name",
      "type": "cli",
      "argv": [
        "Ada",
        "Bob"
      ],
      "stdin_b64": "",
      "exit": 2,
      "stdout": {
        "exact": "",
        "normalize_newlines": true
      },
      "stderr": {
        "not_empty": true
      }
    },
    {
      "name": "empty-name",
      "type": "cli",
      "argv": [
        ""
      ],
      "stdin_b64": "",
      "exit": 2,
      "stdout": {
        "exact": "",
        "normalize_newlines": true
      },
      "stderr": {
        "not_empty": true
      }
    },
    {
      "name": "unknown-option",
      "type": "cli",
      "argv": [
        "--bogus"
      ],
      "stdin_b64": "",
      "exit": 2,
      "stdout": {
        "exact": "",
        "normalize_newlines": true
      },
      "stderr": {
        "not_empty": true
      }
    }
  ]
}
