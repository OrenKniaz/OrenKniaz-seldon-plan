{
  "id": "countdown",
  "kind": "cli",
  "message": "Build countdown.py, a single-file Python standard-library CLI. Accept exactly one nonnegative decimal integer N. Print N down to 1, one per line. N=0 prints nothing. Usage errors (including unknown flags and wrong argument count) exit 2, emit a nonempty diagnostic on stderr and no stdout. Successful runs exit 0 with no stderr. Use UTF-8 text.",
  "profile": {
    "audience": "Local users",
    "care": "Exact behavior and clear errors",
    "tone": "concise and practical",
    "colours": "calm neutral palette",
    "fonts": "system fonts only",
    "sections": "Only the requested features",
    "platform": "Windows, Python 3 standard library; desktop and mobile browser",
    "defaults": "Smallest solution described; no accounts, network assets, deployment or paid services."
  },
  "files": [
    "countdown.py"
  ],
  "oracle": [
    {
      "name": "countdown-three",
      "type": "cli",
      "argv": [
        "3"
      ],
      "stdin_b64": "",
      "exit": 0,
      "stdout": {
        "exact": "3\n2\n1\n",
        "normalize_newlines": true
      },
      "stderr": {
        "exact": ""
      }
    },
    {
      "name": "countdown-zero",
      "type": "cli",
      "argv": [
        "0"
      ],
      "stdin_b64": "",
      "exit": 0,
      "stdout": {
        "exact": "",
        "normalize_newlines": true
      },
      "stderr": {
        "exact": ""
      }
    },
    {
      "name": "negative-number",
      "type": "cli",
      "argv": [
        "-1"
      ],
      "stdin_b64": "",
      "exit": 2,
      "stdout": {
        "exact": "",
        "normalize_newlines": true
      },
      "stderr": {
        "not_empty": true
      }
    },
    {
      "name": "invalid-number",
      "type": "cli",
      "argv": [
        "x"
      ],
      "stdin_b64": "",
      "exit": 2,
      "stdout": {
        "exact": "",
        "normalize_newlines": true
      },
      "stderr": {
        "not_empty": true
      }
    },
    {
      "name": "missing-number",
      "type": "cli",
      "argv": [],
      "stdin_b64": "",
      "exit": 2,
      "stdout": {
        "exact": "",
        "normalize_newlines": true
      },
      "stderr": {
        "not_empty": true
      }
    },
    {
      "name": "unknown-option",
      "type": "cli",
      "argv": [
        "--bogus"
      ],
      "stdin_b64": "",
      "exit": 2,
      "stdout": {
        "exact": "",
        "normalize_newlines": true
      },
      "stderr": {
        "not_empty": true
      }
    }
  ]
}
